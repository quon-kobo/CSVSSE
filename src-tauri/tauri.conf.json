{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CSVSSE",
  "mainBinaryName": "CSVSSE",
  "version": "0.1.4",
  "identifier": "com.csvsse.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "CSVSSE",
        "width": 1100,
        "height": 720,
        "minWidth": 480,
        "minHeight": 320,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "QUON KOBO",
    "copyright": "Copyright (c) 2026 QUON KOBO",
    "shortDescription": "シンプルな CSV エディター",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
